# Template env vars — copy to .env untuk local dev, atau set di Vercel Dashboard untuk production.

# DATABASE — Supabase PostgreSQL (WAJIB)
# Dapatkan dari: Supabase Dashboard → Project Settings → Database → Connection string (pooling, transaction, port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Supabase Client
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxx
