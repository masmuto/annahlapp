# Template env vars — copy to .env untuk local dev, atau set di Vercel Dashboard untuk production.

# === LOCAL DEVELOPMENT (SQLite) ===
DATABASE_URL=file:/home/z/my-project/db/custom.db

# === PRODUCTION (Vercel + Supabase) ===
# Uncomment baris berikut, hapus SQLite di atas, dan set PRISMA_SCHEMA=prisma/schema.vercel.prisma
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# PRISMA_SCHEMA=prisma/schema.vercel.prisma

# Supabase Client (sama untuk local & production)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxx
